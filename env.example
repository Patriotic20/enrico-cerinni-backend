# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5481/enrico_cerrini_dev

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# CORS Configuration
# Comma-separated list of allowed origins (must match the frontend URL exactly,
# including scheme and port). Required for cookie-based auth.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# Optional regex for dynamic origins, e.g. LAN IPs during development:
# CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|192\.168(?:\.\d{1,3}){2})(?::\d+)?$

# Security
SECRET_KEY=your-secret-key-here
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Initial Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123