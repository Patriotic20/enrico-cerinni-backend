# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5481/enrico_cerrini_dev

# JWT Configuration
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left at these placeholder values the app signs tokens with a random per-process
# key instead, which logs every user out on each restart.
JWT_SECRET=your-jwt-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# CORS Configuration
# Comma-separated list of allowed origins (must match the frontend URL exactly,
# including scheme and port). Required for cookie-based auth.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# Optional regex for dynamic origins, e.g. LAN IPs during development:
# CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|192\.168(?:\.\d{1,3}){2})(?::\d+)?$

# Security
SECRET_KEY=your-secret-key-here
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Notifications (nested config: the NOTIFICATION__ prefix is required)
NOTIFICATION__TELEGRAM_BOT_TOKEN=
# SMS via Eskiz.uz — credentials from your my.eskiz.uz cabinet.
# Test accounts can only send the exact text "This is test from Eskiz"
# with the shared sender 4546 until a contract with Eskiz is approved.
NOTIFICATION__SMS_PROVIDER=eskiz
NOTIFICATION__ESKIZ_EMAIL=
NOTIFICATION__ESKIZ_PASSWORD=
NOTIFICATION__SMS_FROM_NUMBER=4546

# Initial Admin Credentials
# Used only when the admin account does not exist yet. An existing admin's
# password is left untouched on startup, so a password changed in the app sticks.
ADMIN_EMAIL=admin@enrico.uz
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Set to true for a single boot to reset a lost admin password from the values
# above, then set it back to false.
ADMIN_FORCE_RESET=false

# Fill an empty database with demo products, clients and debts. Keep false on any
# real deployment — the demo rows are indistinguishable from genuine records.
SEED_MOCK_DATA=false